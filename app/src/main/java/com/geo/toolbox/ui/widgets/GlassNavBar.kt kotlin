package com.geo.toolbox.ui.widgets

import androidx.compose.foundation.layout.Arrangement
import androidx.compose.foundation.layout.Row
import androidx.compose.foundation.layout.fillMaxWidth
import androidx.compose.foundation.layout.padding
import androidx.compose.material3.Text
import androidx.compose.runtime.Composable
import androidx.compose.ui.Modifier
import androidx.compose.ui.unit.dp
import com.geo.toolbox.navigation.NavRoute
import com.geo.toolbox.ui.liquidGlass

@Composable
fun GlassNavBar(
    selectedRoute: NavRoute,
    onRouteSelect: (NavRoute) -> Unit
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .padding(12.dp)
            .liquidGlass(radius = 28.dp),
        horizontalArrangement = Arrangement.SpaceEvenly
    ) {
        listOf(NavRoute.Gps, NavRoute.Analyze, NavRoute.Record, NavRoute.Camera).forEach { route ->
            androidx.compose.foundation.layout.Box(
                modifier = Modifier
                    .padding(12.dp)
                    .clickable { onRouteSelect(route) }
            ) {
                Text(
                    text = route.label,
                    color = if (selectedRoute == route) androidx.compose.ui.graphics.Color.Black
                    else androidx.compose.ui.graphics.Color.DarkGray
                )
            }
        }
    }
}
